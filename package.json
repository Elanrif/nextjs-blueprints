{
  "name": "nextjs-blueprints",
  "version": "1.2.3",
  "private": true,
  "scripts": {
    "check-format": "prettier --check .",
    "check-types": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "clean": "npx rimraf .next dist build out node_modules",
    "bootstrap": "npm run clean && npm install && npm run env:local",
    "bootstrap:ci": "npm run clean && npm ci && npm run env:local",
    "dev": "next dev",
    "env": "npm run env:local",
    "env:local": "shx cp -f env/.env.local .env",
    "env:prod": "shx cp -f env/.env.prod .env",
    "env:staging": "shx cp -f env/.env.staging .env",
    "env:test": "shx cp -f env/.env.test .env",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix --max-warnings=0",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|scss|md)": [
      "npx prettier --write",
      "npx eslint --fix --ext .js,.jsx,.ts,.tsx"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.6",
    "apexcharts": "^4.5.0",
    "axios": "^1.15.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "flatpickr": "^4.6.13",
    "jsvectormap": "^1.6.0",
    "moment": "^2.30.1",
    "next": "^16.1.6",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.4",
    "nextjs-toploader": "^3.7.15",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.74.0",
    "react-toastify": "^11.1.0",
    "rimraf": "^6.1.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/css": "^1.1.0",
    "@tanstack/eslint-plugin-query": "^5.100.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-classnames": "^0.10.1",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "shx": "^0.4.0",
    "tailwind-csstree": "^0.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5"
  }
}
